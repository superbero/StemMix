"""Loop region.

A loop is a pair of (start, end) times in project seconds. When enabled,
playback wraps at `end` back to `start`. Stored on the Project so it
saves with the .stemmix file.

Empty region (start == end or both None) means "no loop".
"""
from dataclasses import dataclass


@dataclass
class LoopRegion:
    start: float = 0.0
    end: float = 0.0
    enabled: bool = False

    def is_active(self):
        return (self.enabled
                and self.end > self.start + 0.05)

    def wrap(self, t):
        """If t is past end, return the wrapped time. Otherwise t."""
        if not self.is_active():
            return t
        length = self.end - self.start
        if t < self.end:
            return t
        if t < self.start:
            # Playhead before loop: leave it alone until it reaches start
            return t
        return self.start + ((t - self.start) % length)

    def to_dict(self):
        return {"start": self.start, "end": self.end,
                "enabled": self.enabled}

    @classmethod
    def from_dict(cls, d):
        if not d:
            return cls()
        return cls(
            start=float(d.get("start", 0.0)),
            end=float(d.get("end", 0.0)),
            enabled=bool(d.get("enabled", False)))
